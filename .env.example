# Local development defaults. Never commit a real .env file or live credentials.
DJANGO_SECRET_KEY=local-only-replace-this-value
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Optional local PostgreSQL. If omitted, Django uses SQLite for local development.
# DATABASE_URL=postgresql://user:password@localhost:5432/kenchaingroups

# To enable real email, configure an SMTP provider and set EMAIL_BACKEND explicitly.
# For Gmail, use an app password, not your regular account password.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=1
# EMAIL_HOST_USER=your-email@example.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=your-email@example.com
# INQUIRY_NOTIFY_EMAIL=team@example.com
